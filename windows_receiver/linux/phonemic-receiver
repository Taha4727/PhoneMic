#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
PARENT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

if [[ -f "$PARENT_DIR/phonemic_receiver.py" ]]; then
    APP_DIR="$PARENT_DIR"
elif [[ -f "/usr/share/phonemic-receiver/phonemic_receiver.py" ]]; then
    APP_DIR="/usr/share/phonemic-receiver"
else
    echo "Error: cannot locate phonemic_receiver.py" >&2
    exit 1
fi

if [[ -x "$APP_DIR/.venv/bin/python" ]]; then
    PYTHON_BIN="$APP_DIR/.venv/bin/python"
else
    PYTHON_BIN="python3"
fi

exec "$PYTHON_BIN" "$APP_DIR/phonemic_receiver.py" "$@"
